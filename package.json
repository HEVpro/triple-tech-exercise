{
  "name": "triple-dispute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dispute case platform for an issuer's chargeback operations team",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:sql": "docker run --rm -v \"$PWD:/workspace\" -w /workspace ghcr.io/sqlfluff/sqlfluff:4.4.0 lint migrations/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts up",
    "db:migrate:status": "tsx --env-file-if-exists=.env scripts/migrate.ts status",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:schema:check": "drizzle-kit check && before=$(ls -R migrations | wc -l) && drizzle-kit generate && test \"$(ls -R migrations | wc -l)\" = \"$before\" || (echo \"schema.ts changed without a migration: run npm run db:generate\" && exit 1)",
    "prepare": "husky",
    "scan:secrets": "docker run --rm -v \"$PWD:/repo\" -w /repo ghcr.io/gitleaks/gitleaks:v8.30.1 git --no-banner --redact ."
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/hono-api-reference": "^0.12.9",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
