NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# The API connects as triple_api, a login role in triple_app: it can read and append, never
# update or delete events. npm run dev:seed creates it locally.
DATABASE_URL=postgres://triple_api:triple_api@localhost:5433/triple
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Migrations and the dev seed run as the schema owner.
MIGRATION_DATABASE_URL=postgres://triple:triple@localhost:5433/triple

# Dev-only HS256 tokens, minted with npm run dev:token. Refused when NODE_ENV=production.
AUTH_MODE=dev
JWT_ISSUER=triple-dev
JWT_AUDIENCE=triple-dispute-api
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

SWEEP_INTERVAL_MS=60000

# Monitoring (docs/SLOS.md). Leave empty locally: nothing is sent without a DSN.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1
