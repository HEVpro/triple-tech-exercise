      "checkConstraints": {
        "case_events_seq_check": {
          "name": "case_events_seq_check",
          "value": "\"case_events\".\"seq\" >= 1"
        },
        "case_events_event_type_check": {
          "name": "case_events_event_type_check",
          "value": "\"case_events\".\"event_type\" IN ('CASE_CREATED', 'EVIDENCE_FILED', 'SCHEME_OUTCOME_RECORDED', 'DEADLINE_EXPIRED', 'NOTE_ADDED')"
        },
        "case_events_actor_type_check": {
          "name": "case_events_actor_type_check",
          "value": "\"case_events\".\"actor_type\" IN ('human', 'agent', 'system')"
        },
        "case_events_actor_id_check": {
          "name": "case_events_actor_id_check",
          "value": "length(\"case_events\".\"actor_id\") BETWEEN 1 AND 200"
        },
        "case_events_from_status_check": {
          "name": "case_events_from_status_check",
          "value": "\"case_events\".\"from_status\" IN ('OPEN', 'UNDER_REVIEW', 'WON', 'LOST')"
        },
        "case_events_to_status_check": {
          "name": "case_events_to_status_check",
          "value": "\"case_events\".\"to_status\" IN ('OPEN', 'UNDER_REVIEW', 'WON', 'LOST')"
        },
        "case_events_rule_key_check": {
          "name": "case_events_rule_key_check",
          "value": "\"case_events\".\"rule_key\" IN ('deadline_passed', 'evidence_filed', 'scheme_outcome', 'default_open')"
        },
        "case_events_reason_check": {
          "name": "case_events_reason_check",
          "value": "length(\"case_events\".\"reason\") <= 1000"
        },
        "case_events_metadata_check": {
          "name": "case_events_metadata_check",
          "value": "jsonb_typeof(\"case_events\".\"metadata\") = 'object' AND pg_column_size(\"case_events\".\"metadata\") <= 16384"
        },
        "case_events_created_from_check": {
          "name": "case_events_created_from_check",
          "value": "(\"case_events\".\"event_type\" = 'CASE_CREATED') = (\"case_events\".\"from_status\" IS NULL)"
        },
        "case_events_rule_presence_check": {
          "name": "case_events_rule_presence_check",
          "value": "(\"case_events\".\"event_type\" = 'NOTE_ADDED') = (\"case_events\".\"rule_key\" IS NULL AND \"case_events\".\"ruleset_version\" IS NULL)"
        },
        "case_events_system_actor_check": {
          "name": "case_events_system_actor_check",
          "value": "(\"case_events\".\"actor_type\" = 'system') = (\"case_events\".\"event_type\" = 'DEADLINE_EXPIRED')"
        },
        "case_events_occurred_at_check": {
          "name": "case_events_occurred_at_check",
          "value": "\"case_events\".\"occurred_at\" = \"case_events\".\"recorded_at\" OR (\"case_events\".\"event_type\" = 'DEADLINE_EXPIRED' AND \"case_events\".\"occurred_at\" <= \"case_events\".\"recorded_at\")"
        }
      },
